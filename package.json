{
  "name": "notebackend",
  "version": "1.0.0",
  "description": "backendForSPA",
  "license": "ISC",
  "author": "Matti Kinnunen",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node index.js",
    "dev": "cross-env NODE_ENV=development node --watch index.js",
    "dev:test": "cross-env NODE_ENV=test node --watch index.js",
    "test": "cross-env  NODE_ENV=test node --test",
    "lint": "eslint .",
    "build:ui": "rm -rf dist && npm --prefix ../React/SinglePageApp run build && cp -r ../React/SinglePageApp/dist ./dist",
    "deploy:full": "npm run build:ui && git add . && git commit -m uibuild && git push"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
